{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "upload:default",
    "upload:allow-download",
    "notifications:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://**" }]
    }
  ]
}
